# Deployer wallet private key (no 0x prefix needed by some tools; include it for clarity)
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# RPC endpoint for Polygon mainnet (e.g. from Alchemy or Infura)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# PolygonScan API key for contract verification
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# DAO treasury / royalty vault address
ROYALTY_VAULT_ADDRESS=0xYOUR_VAULT_ADDRESS_HERE
